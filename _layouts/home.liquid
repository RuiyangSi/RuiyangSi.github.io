---
layout: default
---
{% assign profile = site.data.profile %}
<div class="home">
  <aside class="home-sidebar">
    <div class="home-sticky">
      <div class="home-avatar">
        <img src="{{ profile.avatar | prepend: '/assets/img/' | relative_url }}" alt="{{ site.first_name }} {{ site.last_name }}" loading="eager">
      </div>

      <div class="home-identity">
        <h1 class="home-name">
          {{ site.first_name }}
          {{ site.last_name }}
        </h1>
        {% if profile.role %}
          <p class="home-role">{{ profile.role }}</p>
        {% endif %}
        <p class="home-affiliation">{{ profile.affiliation }}</p>
      </div>

      <div class="home-social">
        {% for s in profile.socials %}
          <a
            href="{% if s.url == '#' or s.url contains '://' or s.url contains 'mailto:' %}{{ s.url }}{% else %}{{ s.url | relative_url }}{% endif %}"
            title="{{ s.name }}"
            aria-label="{{ s.name }}"
            {% if s.id %}
              id="{{ s.id }}"
            {% endif %}
            {% unless s.url contains 'mailto:' or s.url == '#' %}
              target="_blank" rel="noopener noreferrer"
            {% endunless %}
          >
            {%- if s.icon -%}
              <i class="{{ s.icon }}"></i>
            {%- else -%}
              <span class="home-social-text">{{ s.name }}</span>
            {%- endif -%}
          </a>
        {% endfor %}
      </div>

      <div class="home-card">
        <h3>Research Interests</h3>
        <ul>
          {% for item in profile.interests %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </aside>

  <main class="home-main">
    {{ content }}
  </main>
</div>

<div id="wechat-modal" class="wechat-modal" style="display: none;">
  <div class="wechat-dialog">
    <button type="button" id="close-modal" class="wechat-close" aria-label="Close">&times;</button>
    <h3><i class="fa-brands fa-weixin"></i> WeChat</h3>
    <img src="{{ '/assets/img/wechat-qr.png' | relative_url }}" alt="WeChat QR Code">
    <p>Scan to add me on WeChat</p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var modal = document.getElementById('wechat-modal');
    var close = document.getElementById('close-modal');
    document.querySelectorAll('#wechat-link, .wechat-open').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        modal.style.display = 'block';
      });
    });
    close.addEventListener('click', function () {
      modal.style.display = 'none';
    });
    modal.addEventListener('click', function (e) {
      if (e.target === modal) modal.style.display = 'none';
    });
  });
</script>
